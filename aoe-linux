# ---------------------------------------------------------------- launchers
installed_kinds() { local k; for k in aoe1 aoe2; do [ -d "$GAMES/$k" ] && echo $k; done; true; }

# exe_for GAME -> path of the exe (relative to the game folder) or empty
exe_for() {
    local f
    case "$1" in
        aoe1x) has "$GAMES/aoe1" empiresx.exe ;;
        aoe1)  has "$GAMES/aoe1" empires.exe ;;
        aoe2x) if f=$(has "$GAMES/aoe2/age2_x1" age2_x1.exe); then echo "age2_x1/$f"
               else has "$GAMES/aoe2" age2_x1.exe; fi ;;
        aoe2)  has "$GAMES/aoe2" empires2.exe ;;
    esac
    true
}

default_game() {
    local g; for g in "$(cfg_get game)" aoe1x aoe2x aoe2 aoe1; do
        [ -n "$g" ] && [ -n "$(exe_for "$g")" ] && { echo "$g"; return; }
    done
}

# Input methods (IBus/Fcitx with Unikey, Bamboo, Pinyin...) turn the game's hotkeys
# into composed text (Telex eats "w", "dd" becomes a letter). The game wants raw
# English keys, so it starts with no input method; the desktop keeps its own.
# `aoe-linux ime on` opts out of this.
no_ime() {
    [ "$(cfg_get ime)" = on ] && return 0
    export XMODIFIERS="@im=none"
    unset GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE CLUTTER_IM_MODULE
}

ime_cmd() {
    case "${1:-}" in
        on)  cfg_set ime on;  say "The game will use the desktop input method" "Game sẽ dùng bộ gõ của máy" ;;
        off) cfg_set ime off; say "The game starts with no input method (English keys)" "Game chạy không bộ gõ (phím tiếng Anh)" ;;
        "")  if [ "$(cfg_get ime)" = on ]; then say "Input method in game: on" "Bộ gõ trong game: bật"
             else say "Input method in game: off (default)" "Bộ gõ trong game: tắt (mặc định)"; fi ;;
        *)   die "Use: aoe-linux ime on|off" "Cách dùng: aoe-linux ime on|off" ;;
    esac
}

play() {
    local game=${1:-} mode=${2:-fullscreen} exe dir
    [ -x "$WINE" ] && [ -n "$(installed_kinds)" ] || { setup ""; }
    [ -n "$game" ] || game=$(default_game)
    [ -n "$game" ] || die "No game installed. Run: aoe-linux setup" "Chưa có game. Chạy: aoe-linux setup"
    exe=$(exe_for "$game"); [ -n "$exe" ] || die "%s is not installed" "Chưa cài %s" "$game"
    case $game in aoe1*) dir="$GAMES/aoe1"; install_dplay
                         grep -q 'Default Age Of Empires Multiplayer Service' "$WINEPREFIX/user.reg" 2>/dev/null || write_registry aoe1 ;;
                  *) dir="$GAMES/aoe2" ;; esac
    local ini; ini="$(dirname "$dir/$exe")/ddraw.ini"
    if [ -f "$ini" ]; then
        if [ "$mode" = windowed ]; then ini_set "$ini" fullscreen false; else ini_set "$ini" fullscreen true; fi
        ini_set "$ini" windowed true
    fi
    cd "$(dirname "$dir/$exe")"
    no_ime
    if [[ $game == aoe1* ]]; then firewall_check; fi
    # One log per run, the last 5 kept, with Wine's error channel on so a crash
    # leaves something to read (WINEDEBUG=-all would leave nothing).
    mkdir -p "$LOGDIR"
    local run; run="$LOGDIR/play-$(date +%Y%m%d-%H%M%S).log"
    {
        echo "# aoe-linux $VERSION | $game $mode | $(date '+%F %T')"
        echo "# session=${XDG_SESSION_TYPE:-?} display=${DISPLAY:-} wayland=${WAYLAND_DISPLAY:-} ime=$(cfg_get ime)"
        if command -v xrandr >/dev/null 2>&1; then xrandr --listmonitors 2>/dev/null | sed 's/^/# /'; fi
    } >"$run"
    ln -sfn "$run" "$LOG"
    # shellcheck disable=SC2012
    ls -1t "$LOGDIR"/play-*.log 2>/dev/null | tail -n +6 | xargs -r rm -f
    local t0 rc=0; t0=$(date +%s)
    # NOSTARTUP skips the intro videos (they can crash the game)
    AOE_WINEDEBUG="err+all,warn+seh,fixme-all" w "$(basename "$exe")" NOSTARTUP >>"$run" 2>&1 || rc=$?
    local secs=$(( $(date +%s) - t0 ))
    echo "# exit=$rc after ${secs}s" >>"$run"
    if [ "$rc" != 0 ] || grep -qE 'Unhandled exception|Unhandled page fault|wine: Unhandled' "$run"; then
        echo "# CRASH" >>"$run"
        local msg
        msg=$(say "The game closed unexpectedly after %s s.\nLog: %s\nSend this file when reporting the problem (aoe-linux doctor shows the key lines)." \
                  "Game bị thoát đột ngột sau %s giây.\nLog: %s\nGửi file này khi báo lỗi (aoe-linux doctor in ra các dòng chính)." "$secs" "$run")
        echo "aoe-linux: $msg" >&2
        if [ "$GUI" = 1 ]; then zenity --warning --no-markup --title="Age of Empires" --width=480 --text="$msg" 2>/dev/null || true; fi
        return 1
    fi
}

# ---------------------------------------------------------------- firewall (LAN)
# DirectPlay: the host listens on 47624 and every player on 2300-2400, TCP and UDP,
# and the host connects BACK to the joiner. Ubuntu's ufw drops that silently, while
# Windows asks "Allow?" once. Same idea here: ask once per network, open the ports
# for the local subnets only, with the desktop's password prompt.
ufw_enabled() { grep -qs '^ENABLED=yes' /etc/ufw/ufw.conf; }

# local subnets other players can be on (LAN + VPN), container/VM bridges skipped
lan_nets() {
    ip -4 route show proto kernel scope link 2>/dev/null \
        | awk '{dev=""; for(i=1;i<NF;i++) if($i=="dev") dev=$(i+1)} dev !~ /^(docker|br-|virbr|veth|cni|flannel|lxc|vmnet|podman|lo)/ {print $1}' \
        | sort -u | tr '\n' ' ' | sed 's/ $//'
}

firewall_rules() {   # NETS... -> the ufw commands, one per line
    local n
    for n in "$@"; do
        echo "ufw allow from $n to any port 47624 proto tcp"
        echo "ufw allow from $n to any port 47624 proto udp"
        echo "ufw allow from $n to any port 2300:2400 proto tcp"
        echo "ufw allow from $n to any port 2300:2400 proto udp"
    done
}

firewall_open() {    # open now, for the current networks
    local nets; nets=$(lan_nets)
    [ -n "$nets" ] || { say "No local network found" "Không thấy mạng nội bộ nào"; return 1; }
    # shellcheck disable=SC2086
    local cmds; cmds=$(firewall_rules $nets | tr '\n' ';')
    local rc=0
    if [ "$GUI" = 1 ] && command -v pkexec >/dev/null 2>&1; then
        pkexec /bin/sh -c "$cmds" >/dev/null 2>&1 || rc=$?
    else
        say "Opening the DirectPlay ports for: %s (needs your password)" "Mở cổng DirectPlay cho: %s (cần mật khẩu)" "$nets"
        sudo /bin/sh -c "$cmds" >/dev/null || rc=$?
    fi
    if [ "$rc" = 0 ]; then
        cfg_set firewall_nets "$nets"
        say "LAN ports open for: %s" "Đã mở cổng LAN cho: %s" "$nets"
    else
        say "Ports not opened (cancelled or no permission)" "Chưa mở cổng (đã huỷ hoặc không có quyền)"
        return 1
    fi
}

# before an AoE1 launch: ask once when ufw is on and this network is not opened yet
firewall_check() {
    ufw_enabled || return 0
    [ "$(cfg_get firewall)" = never ] && return 0
    local nets opened n missing=""
    nets=$(lan_nets); opened=" $(cfg_get firewall_nets) "
    for n in $nets; do case "$opened" in *" $n "*) ;; *) missing="$missing $n" ;; esac; done
    [ -n "$missing" ] || return 0
    [ "$GUI" = 1 ] || { say "Firewall (ufw) is on: LAN games may not work. Run: aoe-linux firewall" \
                           "Tường lửa (ufw) đang bật: có thể không chơi LAN được. Chạy: aoe-linux firewall"; return 0; }
    local ans=0
    zenity --question --no-markup --title="Age of Empires" --width=480 \
        --ok-label="$(say 'Open the ports' 'Mở cổng')" --cancel-label="$(say 'Not now' 'Để sau')" \
        --extra-button="$(say "Don't ask again" 'Không hỏi lại')" \
        --text="$(say "The firewall (ufw) blocks LAN games.\nOpen the DirectPlay ports (47624, 2300-2400) for your local network%s?\nYou will be asked for your password." \
                      "Tường lửa (ufw) đang chặn chơi LAN.\nMở cổng DirectPlay (47624, 2300-2400) cho mạng nội bộ%s?\nMáy sẽ hỏi mật khẩu của bạn." "$missing")" \
        >"$DATA/.fw-answer" 2>/dev/null || ans=$?
    if [ "$ans" = 0 ]; then firewall_open || true
    elif grep -q . "$DATA/.fw-answer" 2>/dev/null; then cfg_set firewall never
    fi
    rm -f "$DATA/.fw-answer"
}

firewall_cmd() {
    case "${1:-}" in
        ""|on|open) firewall_open ;;
        never|off)  cfg_set firewall never; say "Will not ask about the firewall again" "Sẽ không hỏi về tường lửa nữa" ;;
        ask)        cfg_set firewall ""; cfg_set firewall_nets ""; say "Will ask again on the next launch" "Lần chơi tới sẽ hỏi lại" ;;
        status)
            if ufw_enabled; then say "ufw: on" "ufw: đang bật"; else say "ufw: off (nothing to do)" "ufw: tắt (không cần làm gì)"; fi
            say "Local networks: %s" "Mạng nội bộ: %s" "$(lan_nets)"
            say "Opened by aoe-linux for: %s" "aoe-linux đã mở cổng cho: %s" "$(cfg_get firewall_nets)"
            say "Commands (to run by hand with sudo):" "Lệnh (chạy tay với sudo):"
            # shellcheck disable=SC2046
            firewall_rules $(lan_nets) | sed 's/^/  sudo /' ;;
        *) die "Use: aoe-linux firewall [open|status|never|ask]" "Cách dùng: aoe-linux firewall [open|status|never|ask]" ;;
    esac
}

display_settings() {
    local game exe dir; game=$(default_game); [ -n "$game" ] || die "No game installed" "Chưa có game"
    case $game in aoe1*) dir="$GAMES/aoe1" ;; *) dir="$GAMES/aoe2" ;; esac
    exe=$(exe_for "$game"); cd "$(dirname "$dir/$exe")"
    w "cnc-ddraw config.exe" >/dev/null 2>&1
}

open_folder() {
    local k; k=$(installed_kinds | head -1); [ -n "$k" ] || die "No game installed" "Chưa có game"
    xdg-open "$GAMES/$k" >/dev/null 2>&1 &
}

# ---------------------------------------------------------------- setup
setup() {
    local src=${1:-}
    if [ -z "$src" ]; then
        if [ "$GUI" = 1 ]; then src=$(pick_source_gui) || exit 0
        else
            src=$(autodetect_source || true)
            if [ -n "$src" ]; then say "Found: %s" "Tìm thấy: %s" "$src"; fi
            if [ -t 0 ]; then
                local ans
                read -r -p "$(say 'Game .zip, folder or URL [%s]: ' 'File .zip, thư mục hoặc link game [%s]: ' "$src")" ans
                src=${ans:-$src}
            fi
        fi
        [ -n "$src" ] || die "Tell me where the game is: aoe-linux setup /path/to/game.zip" \
            "Cho biết game ở đâu: aoe-linux setup /đường/dẫn/game.zip"
    fi
    if [ "$GUI" = 1 ]; then
        # run the real work with a progress window; messages starting with # update its text
        exec 3> >(zenity --progress --pulsate --auto-close --no-cancel --width=460 --title="Age of Empires" \
                  --text="$(say 'Setting up...' 'Đang cài đặt...')" 2>/dev/null)
        PROGRESS_FD=3
    fi
    ensure_runtime
    import_game "$src"
    write_desktop_entries
    step "Done" "Xong"
    if [ -n "${PROGRESS_FD:-}" ]; then echo 100 >&3; exec 3>&-; unset PROGRESS_FD; fi
    say "Ready. Start it from the app menu (Age of Empires) or run: aoe-linux" \
        "Xong. Mở game từ menu ứng dụng (Age of Empires) hoặc chạy: aoe-linux"
    say "Installed: %s" "Đã cài: %s" "$IMPORTED"
}

self_path() {
    local p; p=$(command -v aoe-linux 2>/dev/null || true)
    [ -n "$p" ] || p=$(readlink -f "$0")
    echo "$p"
}

# Extra menu entries only for Age of Empires II. The main entry (shipped by the
# package / install.sh) plays Rise of Rome; the 1997 original gets no entry.
write_desktop_entries() {
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications" bin g name
    bin=$(self_path); mkdir -p "$apps"
    rm -f "$apps/aoe-linux-aoe1.desktop"
    for g in aoe2x aoe2; do
        rm -f "$apps/aoe-linux-$g.desktop"
        [ -n "$(exe_for $g)" ] || continue
        [ "$g" = "$(default_game)" ] && continue      # the main entry already plays it
        case $g in
            aoe2x) name="Age of Empires II: The Conquerors" ;;
            aoe2)  name="Age of Empires II" ;;
        esac
        cat >"$apps/aoe-linux-$g.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=$bin play $g
Icon=aoe-linux
Categories=Game;StrategyGame;
StartupNotify=true
EOF
    done
    command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null || true
}

# ---------------------------------------------------------------- doctor
doctor() {
    local ok=1
    say "aoe-linux %s" "aoe-linux %s" "$VERSION"
    say "Data:    %s" "Dữ liệu: %s" "$DATA"
    say "Cache:   %s" "Tải về:  %s" "$CACHE"
    say "Config:  %s" "Cấu hình: %s" "$CONF"
    if [ -x "$WINE" ]; then say "Wine:    %s" "Wine:    %s" "$("$WINE" --version 2>/dev/null)"
    else say "Wine:    not downloaded yet" "Wine:    chưa tải"; fi
    if [ -x "$WINE" ]; then
        # libraries Wine loads at run time for the window, fonts, OpenGL, sound and TLS
        local miss="" lib pkg libs
        libs=$(ldconfig -p 2>/dev/null || true)
        for lib in libX11.so.6:libx11-6 libXext.so.6:libxext6 libXrender.so.1:libxrender1 libXrandr.so.2:libxrandr2 \
                   libXi.so.6:libxi6 libXcursor.so.1:libxcursor1 libfreetype.so.6:libfreetype6 \
                   libfontconfig.so.1:libfontconfig1 libGL.so.1:libgl1 libpulse.so.0:libpulse0 libgnutls.so.30:libgnutls30t64; do
            pkg=${lib#*:}; lib=${lib%%:*}
            case "$libs" in *"$lib "*) ;; *) miss="$miss $pkg" ;; esac
        done
        if [ -n "$miss" ]; then ok=0; say "Missing libraries, install with: sudo apt install%s" "Thiếu thư viện, cài bằng: sudo apt install%s" "$miss"; fi
    fi
    local k; for k in $(installed_kinds); do say "Game:    %s -> %s" "Game:    %s -> %s" "$k" "$GAMES/$k"; done
    [ -n "$(installed_kinds)" ] || { ok=0; say "Game:    not imported (aoe-linux setup)" "Game:    chưa nhập (aoe-linux setup)"; }
    local fonts; fonts=$(fc-list : family 2>/dev/null || true)
    case "$fonts" in *"Liberation Sans"*) say "Fonts:   Liberation OK" "Font:    Liberation OK" ;;
        *) ok=0; say "Fonts:   fonts-liberation missing (sudo apt install fonts-liberation)" "Font:    thiếu fonts-liberation (sudo apt install fonts-liberation)" ;; esac
    command -v zenity >/dev/null || say "zenity:  missing, setup works from the terminal only" "zenity:  không có, chỉ cài được từ terminal"
    if command -v glxinfo >/dev/null; then say "GPU:     %s" "GPU:     %s" "$(glxinfo -B 2>/dev/null | sed -n 's/.*renderer string: //p')"; fi
    say "Proxy:   %s" "Proxy:   %s" "$(proxy_desc)"
    if ufw_enabled; then say "Firewall: ufw on, LAN ports opened for: %s (aoe-linux firewall status)" "Tường lửa: ufw bật, đã mở cổng LAN cho: %s (aoe-linux firewall status)" "$(cfg_get firewall_nets | grep . || echo -)"; fi
    if [ -e "$LOG" ]; then
        local real; real=$(readlink -f "$LOG")
        say "Last run log: %s" "Log lần chơi gần nhất: %s" "$real"
        grep -E '^# (aoe-linux|exit|CRASH)' "$real" | sed 's/^/  /'
        # the distinct Wine errors, most frequent first, minus GPU/EGL noise
        grep -aE ':(err|warn):' "$real" | grep -avE 'libEGL|NtUserChangeDisplaySettings|winemenubuilder' \
            | sed -E 's/^[0-9a-f]{4}://' | sort | uniq -c | sort -rn | head -8 | sed 's/^/  /'
        local n; n=$(grep -l '^# CRASH' "$LOGDIR"/play-*.log 2>/dev/null | wc -l)
        [ "$n" -gt 0 ] && say "Crashes in the last 5 runs: %s (logs in %s)" "Số lần crash trong 5 lần chơi gần nhất: %s (log ở %s)" "$n" "$LOGDIR"
    fi
    [ $ok = 1 ] && say "All good." "Mọi thứ ổn." || return 1
}

uninstall() {
    local yes=${1:-}
    if [ "$yes" != "-y" ]; then
        if [ "$GUI" = 1 ]; then
            zenity --question --width=420 --title="Age of Empires" --text="$(say 'Remove the game, its saves and Wine from %s?' 'Xoá game, file save và Wine trong %s?' "$DATA")" 2>/dev/null || exit 0
        else
            local a; read -r -p "$(say 'Remove %s (game + saves + Wine)? [y/N] ' 'Xoá %s (game + save + Wine)? [y/N] ' "$DATA")" a
            case "$a" in y|Y|yes|co|có) ;; *) exit 0 ;; esac
        fi
    fi
    [ -x "$RUNTIME/bin/wineserver" ] && "$RUNTIME/bin/wineserver" -k 2>/dev/null || true
    rm -rf "$DATA" "$CACHE"
    rm -f "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/aoe-linux-*.desktop
    say "Removed. The aoe-linux command and menu entry stay until you remove the package." \
        "Đã xoá. Lệnh aoe-linux và mục menu còn lại cho tới khi gỡ gói."
}

usage() { sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'; }

cmd=${1:-play}; [ $# -gt 0 ] && shift
apply_proxy
case "$cmd" in
    proxy)         proxy_cmd "${1:-}" ;;
    firewall)      firewall_cmd "${1:-}" ;;
    lan)           lan_info ;;
    name)          set_name "${1:-}" ;;
    ime)           ime_cmd "${1:-}" ;;
    play|run)      play "${1:-}" ;;
    windowed)      play "${1:-}" windowed ;;
    setup|import)  setup "${1:-}" ;;
    display)       display_settings ;;
    folder)        open_folder ;;
    doctor)        doctor ;;
    repair)        [ -x "$WINE" ] || die "Not set up yet: aoe-linux setup" "Chưa cài: aoe-linux setup"
                   if [ -d "$GAMES/aoe1" ]; then rm -f "$WINEPREFIX/drive_c/windows/syswow64/dpwsockx.dll"; install_dplay; write_registry aoe1; fi
                   if [ -d "$GAMES/aoe2" ]; then write_registry aoe2; fi
                   write_desktop_entries; say "Repaired" "Đã sửa xong" ;;
    uninstall)     uninstall "${1:-}" ;;
    aoe1|aoe1x|aoe2|aoe2x) play "$cmd" ;;
    -V|--version|version) echo "aoe-linux $VERSION" ;;
    -h|--help|help) usage ;;
    *) say "Unknown command: %s (aoe-linux --help)" "Lệnh không hợp lệ: %s (aoe-linux --help)" "$cmd"; exit 2 ;;
esac
