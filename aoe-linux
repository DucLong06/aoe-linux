    # addresses on the LAN/VPN interfaces (docker/libvirt bridges would only confuse)
    local ips; ips=$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(docker|br-|virbr|veth|cni|flannel|lxc|vmnet|podman)/ {split($4,a,"/"); printf "%s ", a[1]}' | sed 's/ $//')
    [ -n "$ips" ] || ips=$(hostname -I 2>/dev/null || true)
    local fw fwv firewall_done; firewall_done=$(cfg_get firewall_nets)
    if ufw_enabled; then
        fw="Firewall: ufw is ON. Every player must open the LAN ports: aoe-linux firewall (opened so far for: ${firewall_done:-none})"
        fwv="Tường lửa: ufw đang BẬT. Mọi máy phải mở cổng LAN: aoe-linux firewall (đã mở cho: ${firewall_done:-chưa có})"
    else
        fw="Firewall: ufw is off on this machine (other players' firewalls must allow it too)."
        fwv="Tường lửa: máy này tắt ufw (máy những người chơi khác cũng phải cho phép)."
    fi
    local txt
    txt=$(say "LAN play (Rise of Rome)

This machine: %s   (networks: %s)

Host: Multiplayer -> OK -> Create -> name -> OK -> tick I'm Ready! -> Start Game when everyone is ready.
Join: Multiplayer -> OK -> Show Games -> leave the address empty (search the LAN) or type the host's address -> OK -> pick the game -> Join -> tick I'm Ready!

$fw
Everyone must be on the same network. Player name: %s (change: aoe-linux name \"New name\")" \
"Chơi LAN (Rise of Rome)

Địa chỉ máy này: %s   (mạng: %s)

Tạo phòng: Multiplayer -> OK -> Create -> đặt tên -> OK -> tick I'm Ready! -> Start Game khi mọi người sẵn sàng.
Vào phòng: Multiplayer -> OK -> Show Games -> để trống ô địa chỉ (tự tìm trong LAN) hoặc gõ địa chỉ máy tạo phòng -> OK -> chọn phòng -> Join -> tick I'm Ready!

$fwv
Mọi người phải cùng một mạng. Tên người chơi: %s (đổi: aoe-linux name \"Tên mới\")" "$ips" "$(lan_nets)" "$(player_name)")
    if [ "$GUI" = 1 ]; then zenity --info --title="Age of Empires" --width=520 --no-markup --text="$txt" 2>/dev/null || true
    else echo "$txt"; fi
